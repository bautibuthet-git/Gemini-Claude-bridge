{
  "description": "Gemini bridge: a one-line status banner at session start, and a once-per-file suggestion to delegate big files before Claude reads them whole. Neither ever blocks a session or a Read for good.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/index.js", "--check"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/read-hook.js"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
