{
  "description": "Shows a one-line Gemini bridge status banner when a session starts. Never blocks the session.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/index.js", "--check"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
